# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — never expose to the browser (Vercel → Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: override URL segment for the single event (default: barcelona-pub-golf)
# NEXT_PUBLIC_EVENT_SLUG=barcelona-pub-golf

# Optional: enables POST /api/admin/clear-teams with Authorization: Bearer <this value>. Remove after clearing teams.
# PUBGOLF_TEAMS_CLEAR_SECRET=
