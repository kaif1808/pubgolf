# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — never expose to the browser (Vercel → Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: pepper for hashing organizer keys (defaults to service role if unset — set in production)
# ORGANIZER_PEPPER=long_random_string
